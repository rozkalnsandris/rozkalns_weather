# Private home point. Fill locally only; never commit real values.
HOME_LAT=
HOME_LON=
HOME_TIMEZONE=Europe/Berlin

# Optional human-readable local label; avoid exact street address.
HOME_LABEL=Dortmund-Wickede

# WeatherNext / Google Cloud
GOOGLE_CLOUD_PROJECT=
WEATHERNEXT_BIGQUERY_DATASET=

# Runtime
DATABASE_URL=sqlite:///data/weather.db
