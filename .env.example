WEATHER_RUNTIME_MODE=public-only
WEATHER_CONFIG_PROFILE=development
DATABASE_INIT_MODE=auto
DATABASE_URL=sqlite:///data/weather.db
WEATHER_PORT=9180

# Private home point. Fill locally only; never commit real values.
HOME_LAT=
HOME_LON=
HOME_TIMEZONE=Europe/Berlin
HOME_LABEL=Dortmund-Wickede

INGEST_TIMEOUT_SECONDS=20
INGEST_RETRIES=2
PRECIP_EVENT_THRESHOLD_MM=0.1
