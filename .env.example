# Runtime class. First RPi5 candidate is public-only.
WEATHER_RUNTIME_MODE=public-only
# Development may use auto. Reviewed RPi5 application service uses require-existing.
DATABASE_INIT_MODE=auto
DATABASE_URL=sqlite:///data/weather.db
WEATHER_PORT=9180

# Private home point. Fill locally only; never commit real values.
HOME_LAT=
HOME_LON=
HOME_TIMEZONE=Europe/Berlin
HOME_LABEL=Dortmund-Wickede

# WeatherNext / Google Cloud. Real values are private runtime config and are not
# required for WEATHER_RUNTIME_MODE=public-only.
GOOGLE_CLOUD_PROJECT=
WEATHERNEXT_BIGQUERY_DATASET=

# Ingest policy. Safe defaults; tune only in private runtime when justified.
INGEST_TIMEOUT_SECONDS=20
INGEST_RETRIES=2
PRECIP_EVENT_THRESHOLD_MM=0.1
