{
  "schema_version": 2,
  "repository": "rozkalnsandris/rozkalns_weather",
  "command": {
    "syntax": "AUTO-RUN FULL rozkalns_weather #<issue>",
    "requires_explicit_current_command": true,
    "requires_exact_open_issue": true
  },
  "source_authority": {
    "analysis": true,
    "source_docs_tests": true,
    "branch_commit_push_pr": true,
    "ci_review_convergence": true,
    "scope_preserving_corrective_commits": 2,
    "canonical_issue_pr_merge_authority": true
  },
  "merge": {
    "fresh_exact_head_required": true,
    "required_ci_must_pass": true,
    "unresolved_actionable_threads_must_be_zero": true,
    "force_or_history_rewrite_allowed": false
  },
  "live": {
    "implied": false,
    "separate_exact_authority_required_for": [
      "secrets_credentials",
      "cloudflare_network",
      "database_schema_or_data",
      "systemd_host_permissions",
      "non_standard_runtime_mutation"
    ]
  },
  "invariants": {
    "dwd_warning_authority": true,
    "weathernext_values_may_be_fabricated": false,
    "home_coordinates_may_be_committed": false,
    "provider_provenance_must_be_preserved": true
  }
}
